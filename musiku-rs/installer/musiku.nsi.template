; Template NSIS untuk installer Windows Musiku.
; Placeholder (@EXE@, @ICON@, @OUT@, @WEBVIEW@, @VERSION@) diisi oleh
; build-installer-local.sh. Jangan diedit langsung untuk build.
 Unicode true

 !include "MUI2.nsh"

 Name "Musiku"
 OutFile "@OUT@"
 InstallDir "$LOCALAPPDATA\Programs\Musiku"
 InstallDirRegKey HKCU "Software\Musiku" "Install_Dir"
 RequestExecutionLevel user

 SetCompressor /SOLID lzma

 !define MUI_ICON "@ICON@"
 !define MUI_UNICON "@ICON@"
 !define MUI_ABORTWARNING

 !insertmacro MUI_PAGE_WELCOME
 !insertmacro MUI_PAGE_DIRECTORY
 !insertmacro MUI_PAGE_INSTFILES
 !insertmacro MUI_PAGE_FINISH

 !insertmacro MUI_UNPAGE_CONFIRM
 !insertmacro MUI_UNPAGE_INSTFILES

 !insertmacro MUI_LANGUAGE "English"

 VIProductVersion "@VERSION@.0"
 VIAddVersionKey /LANG=${LANG_ENGLISH} "ProductName" "Musiku"
 VIAddVersionKey /LANG=${LANG_ENGLISH} "FileDescription" "Musiku — Windows Installer"
 VIAddVersionKey /LANG=${LANG_ENGLISH} "FileVersion" "@VERSION@.0"
 VIAddVersionKey /LANG=${LANG_ENGLISH} "LegalCopyright" "Musiku"

 Section "Musiku (required)" SEC_MAIN
   SectionIn RO
   SetOutPath "$INSTDIR"
   File "/oname=Musiku.exe" "@EXE@"
   File "/oname=MicrosoftEdgeWebview2Setup.exe" "@WEBVIEW@"

   WriteUninstaller "$INSTDIR\Uninstall.exe"
   WriteRegStr HKCU "Software\Musiku" "Install_Dir" "$INSTDIR"
   WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku" "DisplayName" "Musiku"
   WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku" "DisplayIcon" "$INSTDIR\Musiku.exe,0"
   WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku" "UninstallString" '"$INSTDIR\Uninstall.exe"'
   WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku" "Publisher" "Musiku"
   WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku" "DisplayVersion" "@VERSION@"
   WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku" "NoModify" 1
   WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku" "NoRepair" 1

   CreateShortcut "$SMPROGRAMS\Musiku.lnk" "$INSTDIR\Musiku.exe"
   CreateShortcut "$DESKTOP\Musiku.lnk" "$INSTDIR\Musiku.exe"
 SectionEnd

 Section "WebView2 runtime" SEC_WEBVIEW2
   ; WebView2 terpasang kalau nilai "pv" ada di salah satu lokasi registry ini.
   ReadRegStr $0 HKLM "SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
   StrCmp $0 "" 0 webview_selesai
   ReadRegStr $0 HKLM "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
   StrCmp $0 "" 0 webview_selesai
   ReadRegStr $0 HKCU "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
   StrCmp $0 "" 0 webview_selesai

   DetailPrint "WebView2 belum ada — memasang runtime (silent)..."
   ExecWait '"$INSTDIR\MicrosoftEdgeWebview2Setup.exe" /silent /install' $1
   DetailPrint "WebView2 bootstrapper selesai (exit $1)."

 webview_selesai:
 SectionEnd

 Section "Uninstall"
   Delete "$INSTDIR\Musiku.exe"
   Delete "$INSTDIR\MicrosoftEdgeWebview2Setup.exe"
   Delete "$INSTDIR\Uninstall.exe"
   RMDir "$INSTDIR"
   Delete "$SMPROGRAMS\Musiku.lnk"
   Delete "$DESKTOP\Musiku.lnk"
   DeleteRegKey HKCU "Software\Musiku"
   DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Musiku"
 SectionEnd
